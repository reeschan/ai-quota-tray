{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Quota",
  "version": "0.1.0",
  "identifier": "dev.aiquota.tray",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:43123",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "AI使用量",
        "width": 420,
        "height": 760,
        "minWidth": 360,
        "minHeight": 520,
        "resizable": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
